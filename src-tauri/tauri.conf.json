{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scour",
  "version": "0.1.0",
  "identifier": "dev.khentmoba.scour",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scour — disk hygiene",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "khentmoba",
    "copyright": "Copyright © 2026 khentmoba",
    "category": "Utility",
    "shortDescription": "Review-first disk cleaner for Windows",
    "longDescription": "Scour scans with the Burrow engine and moves only the files you tick to the Recycle Bin.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/burrow-engine.exe",
      "binaries/LICENSE.md",
      "binaries/THIRD-PARTY-NOTICES.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
